# Docker / Postgres
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=gameconnect_db

# Prisma usa este directamente
DATABASE_URL="postgresql://admin:admin@localhost:5433/gameconnect_db"

# Meilisearch
MEILI_MASTER_KEY=decanatocienciaytecnologiaucla

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=supersecretkeychangeinproduction
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Valkey
VALKEY_URL=redis://localhost:6379

# Meilisearch URL
MEILI_URL=http://localhost:7700

# Supabase Storage
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SECRET_KEY = <your_service_role_key>
SUPABASE_STORAGE_BUCKET=gameconnect-storage

# Resend email
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=noreply@example.com

# IGDB
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
